# Used by both `docker compose` (in this directory) and the tests. Copy to .env and edit.

# --- SpaceTime installation ---------------------------------------------------------------
# The image version the paper's results were measured with. `latest` works too, but may
# behave differently.
VERSION=1.5.0
# Where the containers keep their data (databases, files), relative to this directory.
DATA=./data

# --- LLM used by the agent ----------------------------------------------------------------
# One of: cohere, openrouter, anthropic, gemini, groq, deepseek, cerebras, ollama.
LLM_PROVIDER=cohere
# Optional: a model of that provider. Empty uses the agent's default for the provider
# (GET http://localhost:8030/ shows what is in use).
LLM_MODEL=
# The API key of the provider above (only that one is needed).
COHERE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
# For LLM_PROVIDER=ollama: where Ollama runs, as seen from the agent container.
OLLAMA_URL=http://host.docker.internal:11434

# --- Tests ---------------------------------------------------------------------------------
# Where the tests reach the installation (the ports docker-compose.yml publishes).
SERVER_URL=http://localhost:8010
AGENT_URL=http://localhost:8030
# LLM benchmark: requests per minute to the LLM, for providers with an account rate limit
# (not applied for ollama and openrouter).
RATE_LIMIT=15
# Lamp benchmark: the mock lamp service runs on this port of your machine; the server
# container reaches it as http://MOCK_HOST:MOCK_PORT.
MOCK_PORT=8099
MOCK_HOST=host.docker.internal
# Simulated response time of the lamp service, in ms.
MOCK_LATENCY_MS=2000
# Maximum commands in flight to the lamp service. Empty: the server's default (2000); 0: no cap.
LAMP_MAX_CONCURRENCY=
